create table trainee (
    id serial primary key,
    name varchar Not Null,
    email_address varchar Not Null,
    course_name varchar foreign key
);

create  table course detail (
    id serial primary key,
    course_name varchar unique Not Null,
    course_duration int Not Null,
    Campus varchar Not Null
);


select course_name from trainee inner join table course_detail on trainee.course_name = course_detail.course_name 




